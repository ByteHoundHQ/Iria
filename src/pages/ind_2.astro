<BaseLayout title="Iria — Connect" description="Iria — Connect.">
    <GuardiaAuth />
    <main>
        <VistaIndicador
            titulo="Connect"
            etiquetaBoton="Connect"
            opciones={[
                { id: "clientes", etiqueta: "Clientes", href: "/client" },
                { id: "dashboard", etiqueta: "Dashboard", href: "/dashboard" },
                { id: "reportes", etiqueta: "Reportes" },
            ]}
        />
    </main>
</BaseLayout>
