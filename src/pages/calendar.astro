---
import BaseLayout from "../layouts/BaseLayout.astro";
import GuardiaAuth from "../components/GuardiaAuth.astro";
import { MIEMBROS } from "../lib/calendario";
---

<BaseLayout title="Iria — Calendario" description="Iria — Calendario de pendientes.">
    <link slot="head" rel="preconnect" href="https://fonts.googleapis.com" />
    <link
        slot="head"
        rel="preconnect"
        href="https://fonts.gstatic.com"
        crossorigin
    />
    <link
        slot="head"
        rel="stylesheet"
        href="https://fonts.googleapis.com/css2?family=Poppins:wght@400;500;600;700;800&display=swap"
    />

    <GuardiaAuth />

    <main class="cal">
        <section class="tablero">
            <div class="zona-cal">
                <header class="cal-cabecera">
                    <h1 id="cal-titulo">Mes</h1>
                    <div class="cal-nav">
                        <button
                            type="button"
                            id="btn-prev"
                            class="btn-nav"
                            aria-label="Mes anterior"
                        >
                            ‹
                        </button>
                        <button
                            type="button"
                            id="btn-next"
                            class="btn-nav"
                            aria-label="Mes siguiente"
                        >
                            ›
                        </button>
                        <button type="button" id="btn-hoy" class="btn-hoy">
                            Hoy
                        </button>
                    </div>
                </header>

                <div class="marco-calendario">
                    <div class="calendario">
                        <div class="semana" aria-hidden="true">
                            <span>Lun</span>
                            <span>Mar</span>
                            <span>Mié</span>
                            <span>Jue</span>
                            <span>Vie</span>
                            <span>Sáb</span>
                            <span>Dom</span>
                        </div>
                        <div
                            id="rejilla"
                            class="rejilla"
                            role="grid"
                            aria-label="Calendario mensual"
                        >
                        </div>
                    </div>
                </div>

                <section class="detalle" aria-labelledby="detalle-titulo">
                    <div class="detalle-cab">
                        <h2 id="detalle-titulo">Pendientes del día</h2>
                        <p id="dia-fecha" class="dia-fecha"></p>
                    </div>
                    <ul id="lista-dia" class="lista" aria-live="polite"></ul>
                </section>
            </div>

            <aside class="lateral" aria-labelledby="calendarios-titulo">
                <h2 id="calendarios-titulo">Calendarios</h2>
                <p class="ayuda">Toca uno para mostrarlo u ocultarlo.</p>
                <ul id="lista-calendarios" class="calendarios"></ul>

                <button type="button" id="btn-nota" class="btn-nueva">
                    <svg
                        viewBox="0 0 24 24"
                        fill="none"
                        stroke="currentColor"
                        stroke-width="2.5"
                        stroke-linecap="round"
                        aria-hidden="true"
                    >
                        <path d="M12 5v14M5 12h14"></path>
                    </svg>
                    Crear nota
                </button>
            </aside>

            <a
                href="/ind_1"
                id="boton-volver"
                class="btn-regresar"
                data-astro-prefetch="viewport"
                data-cursor-carga
            >
                <svg
                    class="btn-regresar-icono"
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="2.6"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    aria-hidden="true"
                >
                    <path d="M15 5 8 12l7 7"></path>
                </svg>
                Regresar
            </a>

            <div class="adornos" aria-hidden="true">
                <svg
                    class="asterisco asterisco-azul"
                    viewBox="0 0 100 100"
                    fill="currentColor"
                >
                    {Array.from({ length: 8 }).map((_, i) => (
                        <ellipse
                            cx="50"
                            cy="23"
                            rx="8.5"
                            ry="23"
                            transform={`rotate(${i * 45} 50 50)`}
                        />
                    ))}
                </svg>
                <svg
                    class="asterisco asterisco-vino"
                    viewBox="0 0 100 100"
                    fill="currentColor"
                >
                    {Array.from({ length: 8 }).map((_, i) => (
                        <ellipse
                            cx="50"
                            cy="23"
                            rx="9"
                            ry="24"
                            transform={`rotate(${i * 45} 50 50)`}
                        />
                    ))}
                </svg>
            </div>
        </section>

        <div id="modal" class="modal" hidden>
            <div
                class="modal-caja"
                role="dialog"
                aria-modal="true"
                aria-labelledby="modal-titulo"
            >
                <h2 id="modal-titulo">Nueva nota</h2>
                <form id="form-nota">
                    <div class="renglon">
                        <label class="campo">
                            Fecha
                            <input id="f-fecha" type="date" required />
                        </label>
                        <label class="campo">
                            Calendario
                            <span class="selector-cal">
                                <span
                                    id="f-cal-punto"
                                    class="punto-cal"
                                    aria-hidden="true"
                                ></span>
                                <select id="f-calendario">
                                    <option value="importante">
                                        Importante
                                    </option>
                                    <option value="bravar">Bravar</option>
                                    <option value="dega">Degá</option>
                                    <option value="calesa">Calesa</option>
                                    <option value="ibis">Ibis</option>
                                </select>
                            </span>
                        </label>
                    </div>
                    <div class="renglon">
                        <label class="campo">
                            Tipo de pendiente
                            <select id="f-tipo">
                                <option value="parrilla">Pendiente de parrilla</option>
                                <option value="subir">Por subir</option>
                                <option value="imagen">Creación de imagen</option>
                                <option value="nota" selected>Nota</option>
                            </select>
                        </label>
                        <label class="campo">
                            Asignar a
                            <span class="selector-cal">
                                <span
                                    id="f-asignado-punto"
                                    class="punto-cal punto-miembro"
                                    aria-hidden="true"
                                ></span>
                                <select id="f-asignado">
                                    <option value="">Sin asignar</option>
                                    {MIEMBROS.map((m) => (
                                        <option value={m.id} data-color={m.color}>
                                            {m.nombre}
                                        </option>
                                    ))}
                                </select>
                            </span>
                        </label>
                    </div>
                    <label class="campo">
                        Título
                        <input
                            id="f-titulo"
                            type="text"
                            placeholder="Ej. Revisar copy Bravar"
                            required
                            maxlength="80"
                        />
                    </label>
                    <label class="campo">
                        Detalle
                        <textarea
                            id="f-detalle"
                            rows="3"
                            placeholder="Opcional"
                        ></textarea>
                    </label>
                    <div class="modal-acciones">
                        <button
                            type="button"
                            id="btn-cancelar"
                            class="btn-secundario"
                        >
                            Cancelar
                        </button>
                        <button type="submit" class="btn-primario">
                            Guardar
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </main>
</BaseLayout>

<script>
    import {
        CALENDARIOS,
        MESES,
        POR_CALENDARIO,
        POR_MIEMBRO,
        TIPOS,
        crearSemillas,
        guardarNotas,
        leerNotas,
    } from "../lib/calendario";

    const KEY_OCULTOS = "iria_calendar_calendarios_ocultos";
    const porCalendario = POR_CALENDARIO;
    const porMiembro = POR_MIEMBRO;

    const hoy = new Date();
    const pad = (n: number) => String(n).padStart(2, "0");
    const aFecha = (d: Date) =>
        `${d.getFullYear()}-${pad(d.getMonth() + 1)}-${pad(d.getDate())}`;

    const semillas = crearSemillas();

    const estado = {
        y: hoy.getFullYear(),
        m: hoy.getMonth(),
        sel: aFecha(hoy),
    };

    const rejilla = document.getElementById("rejilla");
    const titulo = document.getElementById("cal-titulo");
    const listaDia = document.getElementById("lista-dia");
    const diaFecha = document.getElementById("dia-fecha");
    const listaCalendarios = document.getElementById("lista-calendarios");
    const modal = document.getElementById("modal");
    const form = document.getElementById("form-nota") as HTMLFormElement | null;
    const fFecha = document.getElementById("f-fecha") as HTMLInputElement | null;
    const fCalendario = document.getElementById(
        "f-calendario",
    ) as HTMLSelectElement | null;
    const fAsignado = document.getElementById(
        "f-asignado",
    ) as HTMLSelectElement | null;
    const fCalPunto = document.getElementById("f-cal-punto");
    const fAsignadoPunto = document.getElementById("f-asignado-punto");

    function leerOcultos(): Set<string> {
        try {
            const crudo = JSON.parse(
                window.localStorage.getItem(KEY_OCULTOS) ?? "[]",
            );
            return new Set(Array.isArray(crudo) ? crudo : []);
        } catch {
            return new Set();
        }
    }

    function guardarOcultos() {
        try {
            window.localStorage.setItem(
                KEY_OCULTOS,
                JSON.stringify([...ocultos]),
            );
        } catch {
            /* sin almacenamiento disponible */
        }
    }

    const ocultos = leerOcultos();
    const todosSinFiltro = () => [...semillas, ...leerNotas()];
    const todos = () =>
        todosSinFiltro().filter((e) => !ocultos.has(e.calendario));
    const eventosDel = (fecha: string) =>
        todos().filter((e) => e.fecha === fecha);
    const contarCalendario = (id: string) =>
        todosSinFiltro().filter((e) => e.calendario === id).length;
    const miembroDe = (id?: string) =>
        id ? porMiembro[id] : undefined;

    function pintarCalendarios() {
        if (!listaCalendarios) return;
        listaCalendarios.innerHTML = "";
        CALENDARIOS.forEach((c) => {
            const li = document.createElement("li");
            li.className = "calendario-item";

            const label = document.createElement("label");
            const input = document.createElement("input");
            input.type = "checkbox";
            input.checked = !ocultos.has(c.id);
            input.setAttribute(
                "aria-label",
                `Mostrar el calendario ${c.nombre}`,
            );

            const marca = document.createElement("span");
            marca.className = "marca";
            marca.style.setProperty("--c", c.color);
            marca.setAttribute("aria-hidden", "true");

            const nombre = document.createElement("span");
            nombre.className = "nombre";
            nombre.textContent = c.nombre;

            const cuenta = document.createElement("span");
            cuenta.className = "cuenta";
            cuenta.textContent = String(contarCalendario(c.id));

            label.append(input, marca, nombre, cuenta);
            input.addEventListener("change", () => {
                if (input.checked) ocultos.delete(c.id);
                else ocultos.add(c.id);
                guardarOcultos();
                pintar();
                pintarDia();
            });

            li.append(label);
            listaCalendarios.append(li);
        });
    }

    function pintar() {
        if (!rejilla || !titulo) return;
        titulo.textContent = `${MESES[estado.m]} ${estado.y}`;
        rejilla.innerHTML = "";

        const primero = new Date(estado.y, estado.m, 1);
        const desfase = (primero.getDay() + 6) % 7;
        const dias = new Date(estado.y, estado.m + 1, 0).getDate();

        for (let i = 0; i < desfase; i++) {
            const v = document.createElement("span");
            v.className = "vacio";
            rejilla.appendChild(v);
        }

        for (let d = 1; d <= dias; d++) {
            const fecha = `${estado.y}-${pad(estado.m + 1)}-${pad(d)}`;
            const evs = eventosDel(fecha);

            const b = document.createElement("button");
            b.type = "button";
            b.className = "dia";
            b.setAttribute("role", "gridcell");

            if (fecha === estado.sel) b.classList.add("sel");
            if (fecha === aFecha(hoy)) b.classList.add("hoy");

            const num = document.createElement("span");
            num.className = "num";
            num.textContent = String(d);
            b.appendChild(num);

            const puntos = document.createElement("span");
            puntos.className = "puntos";
            evs.slice(0, 3).forEach((e) => {
                const cal = porCalendario[e.calendario] ?? porCalendario.importante;
                const p = document.createElement("span");
                p.className = "punto";
                p.style.setProperty("--c", cal.color);
                puntos.appendChild(p);
            });
            if (evs.length > 3) {
                const mas = document.createElement("span");
                mas.className = "mas";
                mas.textContent = `+${evs.length - 3}`;
                puntos.appendChild(mas);
            }
            b.appendChild(puntos);

            const resumen = evs.length
                ? evs
                      .map((e) => {
                          const cal =
                              porCalendario[e.calendario] ??
                              porCalendario.importante;
                          const miembro = miembroDe(e.asignado);
                          return `${e.titulo} · ${cal.nombre}${miembro ? ` · ${miembro.nombre}` : ""}`;
                      })
                      .join("\n")
                : "Día libre";
            b.title = resumen;
            b.setAttribute(
                "aria-label",
                `${d} de ${MESES[estado.m]}: ${evs.length} pendiente(s)`,
            );

            b.addEventListener("click", () => {
                estado.sel = fecha;
                pintar();
                pintarDia();
            });

            rejilla.appendChild(b);
        }

        const totalCeldas = desfase + dias;
        const sobrantes = (7 - (totalCeldas % 7)) % 7;
        for (let i = 0; i < sobrantes; i++) {
            const v = document.createElement("span");
            v.className = "vacio";
            rejilla.appendChild(v);
        }
    }

    function pintarDia() {
        if (!listaDia) return;
        const evs = eventosDel(estado.sel);
        const [y, m, d] = estado.sel.split("-").map(Number);
        if (diaFecha) {
            diaFecha.textContent = `${d} de ${MESES[m - 1]} de ${y} · ${evs.length} pendiente(s)`;
        }

        listaDia.innerHTML = "";
        if (!evs.length) {
            const hayOcultos = todosSinFiltro().some(
                (e) => e.fecha === estado.sel && ocultos.has(e.calendario),
            );
            const li = document.createElement("li");
            li.className = "vacio-msg";
            li.textContent = hayOcultos
                ? "Todo lo de este día está en calendarios ocultos. Actívalos para verlo."
                : "Día libre. Usa «Crear nota» para agregar un pendiente aquí.";
            listaDia.appendChild(li);
            return;
        }

        const notas = leerNotas();
        evs.forEach((e) => {
            const cal = porCalendario[e.calendario] ?? porCalendario.importante;
            const miembro = miembroDe(e.asignado);
            const li = document.createElement("li");
            li.className = "item";
            li.style.setProperty("--c", cal.color);

            const marca = document.createElement("span");
            marca.className = "item-marca";
            marca.setAttribute("aria-hidden", "true");

            const texto = document.createElement("div");
            texto.className = "item-texto";

            const tituloItem = document.createElement("strong");
            tituloItem.textContent = e.titulo || "Sin título";

            const meta = document.createElement("span");
            meta.className = "item-meta";
            meta.textContent = `${cal.nombre} · ${TIPOS[e.tipo] ?? e.tipo}`;

            texto.append(tituloItem, meta);

            if (miembro) {
                const asignado = document.createElement("span");
                asignado.className = "item-asignado";
                asignado.style.setProperty("--c", miembro.color);
                asignado.textContent = `Asignado a ${miembro.nombre}`;
                texto.appendChild(asignado);
            }

            if (e.detalle) {
                const det = document.createElement("span");
                det.className = "item-det";
                det.textContent = e.detalle;
                texto.appendChild(det);
            }

            li.append(marca, texto);

            if (e.id) {
                const del = document.createElement("button");
                del.type = "button";
                del.className = "btn-del";
                del.setAttribute("aria-label", `Eliminar ${e.titulo}`);
                del.innerHTML =
                    '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="M6 6l12 12M18 6 6 18"></path></svg>';
                del.addEventListener("click", () => {
                    guardarNotas(notas.filter((n) => n.id !== e.id));
                    pintar();
                    pintarDia();
                    pintarCalendarios();
                });
                li.appendChild(del);
            }

            listaDia.appendChild(li);
        });
    }

    function actualizarPuntoCalendario() {
        if (!fCalendario || !fCalPunto) return;
        const cal = porCalendario[fCalendario.value] ?? porCalendario.importante;
        fCalPunto.style.setProperty("--c", cal.color);
    }

    function actualizarPuntoAsignado() {
        if (!fAsignado || !fAsignadoPunto) return;
        const miembro = miembroDe(fAsignado.value);
        fAsignadoPunto.style.setProperty(
            "--c",
            miembro ? miembro.color : "#cbb8a4",
        );
    }

    function abrirModal() {
        modal?.removeAttribute("hidden");
        if (fFecha) fFecha.value = estado.sel;
        actualizarPuntoCalendario();
        actualizarPuntoAsignado();
        (document.getElementById("f-titulo") as HTMLInputElement | null)?.focus();
    }

    function cerrarModal() {
        modal?.setAttribute("hidden", "");
    }

    document.getElementById("btn-prev")?.addEventListener("click", () => {
        estado.m--;
        if (estado.m < 0) {
            estado.m = 11;
            estado.y--;
        }
        pintar();
    });

    document.getElementById("btn-next")?.addEventListener("click", () => {
        estado.m++;
        if (estado.m > 11) {
            estado.m = 0;
            estado.y++;
        }
        pintar();
    });

    document.getElementById("btn-hoy")?.addEventListener("click", () => {
        estado.y = hoy.getFullYear();
        estado.m = hoy.getMonth();
        estado.sel = aFecha(hoy);
        pintar();
        pintarDia();
    });

    document.getElementById("btn-nota")?.addEventListener("click", abrirModal);
    document
        .getElementById("btn-cancelar")
        ?.addEventListener("click", cerrarModal);

    modal?.addEventListener("click", (e) => {
        if (e.target === modal) cerrarModal();
    });

    document.addEventListener("keydown", (e) => {
        if (e.key === "Escape") cerrarModal();
    });

    fCalendario?.addEventListener("change", actualizarPuntoCalendario);
    fAsignado?.addEventListener("change", actualizarPuntoAsignado);

    form?.addEventListener("submit", (e) => {
        e.preventDefault();
        const fecha = (document.getElementById("f-fecha") as HTMLInputElement)
            .value;
        const calendario = (
            document.getElementById("f-calendario") as HTMLSelectElement
        ).value;
        const tipo = (document.getElementById("f-tipo") as HTMLSelectElement)
            .value;
        const asignado = (document.getElementById("f-asignado") as HTMLSelectElement)
            .value;
        const tituloN = (
            document.getElementById("f-titulo") as HTMLInputElement
        ).value.trim();
        const detalle = (
            document.getElementById("f-detalle") as HTMLTextAreaElement
        ).value.trim();
        if (!fecha || !tituloN) return;

        const notas = leerNotas();
        notas.push({
            id: `n${Date.now()}`,
            fecha,
            calendario,
            tipo,
            asignado,
            titulo: tituloN,
            detalle,
        });
        guardarNotas(notas);

        if (ocultos.has(calendario)) {
            ocultos.delete(calendario);
            guardarOcultos();
        }

        const [y, m] = fecha.split("-").map(Number);
        estado.y = y;
        estado.m = m - 1;
        estado.sel = fecha;

        form.reset();
        if (fCalendario) fCalendario.value = calendario;
        cerrarModal();
        pintar();
        pintarDia();
        pintarCalendarios();
    });

    pintarCalendarios();
    pintar();
    pintarDia();
</script>

<style is:global>
    .cal {
        min-height: 100vh;
        box-sizing: border-box;
        padding: 18px;
        background: #5c1011;
        display: flex;
        width: 100%;
        margin: 0;
        font-family: "Poppins", system-ui, sans-serif;
        color: #3b2118;
    }

    .cal button,
    .cal input,
    .cal select,
    .cal textarea {
        font-family: inherit;
    }

    .tablero {
        position: relative;
        flex: 1;
        display: grid;
        grid-template-columns: minmax(0, 1.35fr) minmax(250px, 0.78fr);
        grid-template-rows: 1fr auto;
        column-gap: clamp(1.75rem, 4.5vw, 4.5rem);
        row-gap: clamp(1.25rem, 2.6vw, 2rem);
        box-sizing: border-box;
        width: 100%;
        min-height: calc(100vh - 36px);
        padding: clamp(1.5rem, 3.2vw, 2.75rem) clamp(1.5rem, 3.2vw, 3rem)
            clamp(1.5rem, 2.6vw, 2.25rem);
        border-radius: 30px;
        background: #fbf9f0;
        box-shadow: 0 22px 45px rgba(30, 3, 3, 0.35);
        overflow: hidden;
    }

    .zona-cal {
        grid-column: 1;
        grid-row: 1;
        display: flex;
        flex-direction: column;
        min-width: 0;
    }

    .cal-cabecera {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 1rem;
        margin-bottom: 1.1rem;
    }

    .cal-cabecera h1 {
        margin: 0;
        font-size: clamp(1.05rem, 1.7vw, 1.35rem);
        font-weight: 800;
        letter-spacing: 0.03em;
        text-transform: uppercase;
        color: #3b2118;
    }

    .cal-nav {
        display: flex;
        align-items: center;
        gap: 0.45rem;
    }

    .btn-nav,
    .btn-hoy {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        height: 34px;
        border: 1px solid rgba(110, 13, 13, 0.2);
        background: #fffdf7;
        color: #6e0d0d;
        border-radius: 999px;
        cursor: pointer;
        transition:
            background 150ms ease,
            border-color 150ms ease;
    }

    .btn-nav {
        width: 34px;
        font-size: 1.25rem;
        line-height: 1;
        padding: 0 0 0.15rem;
    }

    .btn-hoy {
        padding: 0 1rem;
        font-size: 0.75rem;
        font-weight: 700;
        letter-spacing: 0.08em;
        text-transform: uppercase;
    }

    .btn-nav:hover,
    .btn-hoy:hover {
        background: #f7efe0;
        border-color: rgba(110, 13, 13, 0.4);
    }

    .btn-nav:focus-visible,
    .btn-hoy:focus-visible {
        outline: 2px solid #6e0d0d;
        outline-offset: 2px;
    }

    .marco-calendario {
        padding: 7px;
        border-radius: 26px;
        background: linear-gradient(
            150deg,
            #f8edb6 0%,
            #f1dcc2 18%,
            #cfa9a2 30%,
            #893734 42%,
            #6e0d0d 53%,
            #7c919d 69%,
            #c9e0ec 85%,
            #e8f3f8 100%
        );
        box-shadow: 0 12px 26px rgba(92, 16, 17, 0.16);
    }

    .calendario {
        border-radius: 20px;
        background: #fffdf7;
