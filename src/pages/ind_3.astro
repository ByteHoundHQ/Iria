---
import BaseLayout from "../layouts/BaseLayout.astro";
import GuardiaAuth from "../components/GuardiaAuth.astro";
import VistaIndicador from "../components/VistaIndicador.astro";
---

<BaseLayout title="Iria — Create" description="Iria — Create.">
    <GuardiaAuth />
    <main>
        <VistaIndicador
            titulo="Create"
            etiquetaBoton="Create"
            opciones={[
                { id: "parrilla", etiqueta: "Parrilla contenido" },
                { id: "historial", etiqueta: "Historial" },
                { id: "archivos", etiqueta: "Archivos", href: "/upload" },
            ]}
        />
    </main>
</BaseLayout>
