---
import BaseLayout from "../layouts/BaseLayout.astro";
import GuardiaAuth from "../components/GuardiaAuth.astro";
import VistaIndicador from "../components/VistaIndicador.astro";
---

<BaseLayout title="Iria — Communicate" description="Iria — Communicate.">
    <GuardiaAuth />
    <main>
        <VistaIndicador
            titulo="Communicate"
            etiquetaBoton="Communicate"
            opciones={[
                { id: "tareas", etiqueta: "Tareas" },
                { id: "calendario", etiqueta: "Calendario mensual", href: "/calendar" },
                { id: "aprobaciones", etiqueta: "Aprobaciones" },
            ]}
        />
    </main>
</BaseLayout>
