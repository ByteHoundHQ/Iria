---
import BaseLayout from "../layouts/BaseLayout.astro";
import GuardiaAuth from "../components/GuardiaAuth.astro";

const metricas = [
    { id: "alcance", nombre: "Alcance" },
    { id: "interacciones", nombre: "Interacciones" },
    { id: "seguidores", nombre: "Seguidores" },
];
---

<BaseLayout title="Iria — Reportes" description="Iria — Reportes.">
    <GuardiaAuth />
    <main class="rep">
        <header class="rep-top">
            <h1>Reportes</h1>
            <div class="rep-acciones">
                <div class="menu-wrap">
                    <button
                        type="button"
                        class="rep-link"
                        id="btn-importar"
                        aria-expanded="false"
                        aria-controls="menu-importar"
                    >
                        Importar
                    </button>
                    <div class="menu" id="menu-importar" hidden>
                        <p>Importar para</p>
                        <button type="button" data-importar="alcance">Alcance</button>
                        <button type="button" data-importar="interacciones">
                            Interacciones
                        </button>
                        <button type="button" data-importar="seguidores">
                            Seguidores
                        </button>
                    </div>
                </div>
                <a
                    href="/ind_2"
                    class="btn-regresar"
                    data-astro-prefetch="viewport"
                    data-cursor-carga
                >
                    Regresar
                </a>
            </div>
        </header>

        <div class="rep-layout">
            <aside class="rep-aside" aria-label="Secciones del reporte">
                <nav class="nav-metricas" aria-label="Métricas y presentación">
                    {
                        metricas.map((m) => (
                            <button type="button" class="nav-item" data-ir={m.id}>
                                <span>{m.nombre}</span>
                                <span class="nav-cuenta" data-cuenta={m.id}>
                                    0
                                </span>
                            </button>
                        ))
                    }
                    <hr class="nav-separador" />
                    <button
                        type="button"
                        class="nav-item"
                        data-ir="presentacion"
                    >
                        <span>Presentación</span>
                        <span class="nav-cuenta" data-cuenta="presentacion">
                            0
                        </span>
                    </button>
                </nav>

                <p class="aside-nota">
                    Los datos se guardan en este navegador.
                </p>
            </aside>

            <div class="rep-main">
                {
                    metricas.map((m) => (
                        <section
                            class="vista"
                            data-vista={m.id}
                            aria-labelledby={`titulo-${m.id}`}
                            hidden={m.id !== "alcance"}
                        >
                            <header class="vista-cab">
                                <div>
                                    <h2 id={`titulo-${m.id}`}>{m.nombre}</h2>
                                    <p class="vista-sub" data-sub={m.id}>
                                        Sin datos.
                                    </p>
                                </div>
                                <div class="vista-acciones">
                                    <button
                                        type="button"
                                        class="btn btn-primario"
                                        data-accion="importar"
                                        data-metrica={m.id}
                                    >
                                        Importar
                                    </button>
                                    <button
                                        type="button"
                                        class="btn"
                                        data-accion="manual"
                                        data-metrica={m.id}
                                        aria-expanded="false"
                                        aria-controls={`form-${m.id}`}
                                    >
                                        Agregar
                                    </button>
                                    <button
                                        type="button"
                                        class="btn btn-fantasma"
                                        data-accion="limpiar"
                                        data-metrica={m.id}
                                    >
                                        Limpiar
                                    </button>
                                </div>
                            </header>

                            <form
                                class="form-manual"
                                id={`form-${m.id}`}
                                data-form={m.id}
                                hidden
                            >
                                <label>
                                    Fecha
                                    <input type="date" name="fecha" required />
                                </label>
                                <label>
                                    Valor
                                    <input
                                        type="number"
                                        name="valor"
                                        min="0"
                                        step="any"
                                        inputmode="decimal"
                                        placeholder="0"
                                        required
                                    />
                                </label>
                                <button
                                    type="submit"
                                    class="btn btn-primario"
                                >
                                    Agregar dato
                                </button>
                                <button
                                    type="button"
                                    class="btn btn-fantasma"
                                    data-accion="cerrar-manual"
                                    data-metrica={m.id}
                                >
                                    Cancelar
                                </button>
                                <p class="form-ayuda">
                                    CSV o JSON con columnas Fecha y Valor.
                                </p>
                            </form>

                            <input
                                type="file"
                                accept=".csv,.json,.txt,text/csv,application/json"
                                hidden
                                data-file={m.id}
                            />

                            <article class="panel panel-grafica">
                                <div class="panel-cab">
                                    <h3>Evolución</h3>
                                    <span
                                        class="panel-nota"
                                        data-rango={m.id}
                                    />
                                </div>
                                <p class="vacio" data-vacio={m.id}>
                                    Importa o agrega valores para ver la
                                    gráfica.
                                </p>
                                <div
                                    class="grafica"
                                    data-grafica={m.id}
                                    hidden
                                />
                            </article>

                            <article class="panel">
                                <div class="panel-cab">
                                    <h3>Datos</h3>
                                    <span
                                        class="panel-nota"
                                        data-conteo={m.id}
                                    >
                                        0 registros
                                    </span>
                                </div>
                                <div class="tabla-wrap" hidden>
                                    <table
                                        class="tabla-datos"
                                        data-tabla={m.id}
                                    >
                                        <thead>
                                            <tr>
                                                <th>Fecha</th>
                                                <th>Valor</th>
                                                <th>Cambio</th>
                                                <th>
                                                    <span class="sr-only">
                                                        Acciones
                                                    </span>
                                                </th>
                                            </tr>
                                        </thead>
                                        <tbody />
                                    </table>
                                </div>
                                <p
                                    class="vacio-tabla"
                                    data-vacio-tabla={m.id}
                                >
                                    Sin registros.
                                </p>
                            </article>

                            <article class="panel">
                                <div class="panel-cab">
                                    <h3>Fotos</h3>
                                    <div class="panel-cab-acciones">
                                        <span
                                            class="panel-nota"
                                            data-conteo-fotos={m.id}
                                        >
                                            0 fotos
                                        </span>
                                        <button
                                            type="button"
                                            class="btn btn-primario btn-chico"
                                            data-accion="fotos"
                                            data-metrica={m.id}
                                        >
                                            Agregar
                                        </button>
                                    </div>
                                </div>
                                <div
                                    class="galeria"
                                    data-galeria={m.id}
                                />
                                <input
                                    type="file"
                                    accept="image/*"
                                    multiple
                                    hidden
                                    data-fotos-input={m.id}
                                />
                            </article>
                        </section>
                    ))
                }

                <section
                    class="vista"
                    data-vista="presentacion"
                    aria-labelledby="titulo-presentacion"
                    hidden
                >
                    <header class="vista-cab">
                        <div>
                            <h2 id="titulo-presentacion">Presentación</h2>
                        </div>
                        <div class="vista-acciones">
                            <button
                                type="button"
                                class="btn"
                                data-accion="exportar"
                            >
                                Exportar
                            </button>
                            <button
                                type="button"
                                class="btn btn-primario"
                                data-accion="imprimir"
                            >
                                Imprimir
                            </button>
                        </div>
                    </header>

                    <div class="pres-doc" data-presentacion>
                        <header class="pres-portada">
                            <h2>Reportes</h2>
                            <p class="pres-fecha" data-pres-fecha></p>
                        </header>

                        {
                            metricas.map((m) => (
                                <article
                                    class="pres-bloque"
                                    data-pres-bloque={m.id}
                                    hidden
                                >
                                    <header class="pres-bloque-cab">
                                        <h3>{m.nombre}</h3>
                                        <span
                                            class="pres-rango"
                                            data-pres-rango={m.id}
                                        />
                                    </header>
                                    <div
                                        class="pres-kpis"
                                        data-pres-kpis={m.id}
                                    />
                                    <div
                                        class="grafica"
                                        data-pres-grafica={m.id}
                                        hidden
                                    />
                                    <div
                                        class="tabla-wrap"
                                        data-pres-tabla-wrap={m.id}
                                    >
                                        <table
                                            class="tabla-datos"
                                            data-pres-tabla={m.id}
                                        >
                                            <thead>
                                                <tr>
                                                    <th>Fecha</th>
                                                    <th>Valor</th>
                                                    <th>Cambio</th>
                                                </tr>
                                            </thead>
                                            <tbody />
                                        </table>
                                    </div>
                                    <p
                                        class="pres-subtitulo"
                                        data-pres-fotos-label={m.id}
                                        hidden
                                    >
                                        Capturas
                                    </p>
                                    <div
                                        class="galeria galeria--pres"
                                        data-pres-galeria={m.id}
                                    />
                                </article>
                            ))
                        }
                        <p class="vacio" data-pres-vacio>
                            Agrega datos o fotos para armar la presentación.
                        </p>
                    </div>
                </section>
            </div>
        </div>
    </main>

    <div id="rep-toast" class="rep-toast" role="status" aria-live="polite"></div>

    <div
        id="lightbox"
        class="lightbox"
        role="dialog"
        aria-modal="true"
        aria-label="Vista previa de imagen"
        hidden
    >
        <button
            type="button"
            class="lightbox-cerrar"
            aria-label="Cerrar vista previa"
        >
            ×
        </button>
        <figure>
            <img id="lightbox-img" alt="" />
            <figcaption id="lightbox-caption"></figcaption>
        </figure>
    </div>
</BaseLayout>

<style is:global>
    .rep {
        --tinta: #1f262e;
        --tinta-suave: #5f6b78;
        --linea: #39424c;
        --linea-tenue: #d5dbe1;
        --acento: #2c6076;
        --acento-suave: #d9e9f0;
        --papel: rgba(255, 255, 255, 0.74);
        min-height: 100vh;
        box-sizing: border-box;
        padding: clamp(1rem, 2.2vw, 1.8rem);
        background-color: #f5f6f4;
        background-image: radial-gradient(
            #d4dae0 1.2px,
            transparent 1.2px
        );
        background-size: 20px 20px;
        color: var(--tinta);
    }
    .rep h1,
    .rep h2,
    .rep h3,
    .rep p {
        overflow-wrap: anywhere;
    }
    .rep :where(button, a, input):focus-visible {
        outline: 2px solid var(--acento);
        outline-offset: 3px;
    }
    .sr-only {
        position: absolute;
        width: 1px;
        height: 1px;
        margin: -1px;
        padding: 0;
        overflow: hidden;
        clip: rect(0 0 0 0);
        clip-path: inset(50%);
        white-space: nowrap;
        border: 0;
    }

    /* ---------- Encabezado ---------- */
    .rep-top {
        max-width: 1500px;
        margin: 0 auto clamp(1rem, 2vw, 1.4rem);
        display: flex;
        justify-content: space-between;
        align-items: flex-end;
        gap: 1rem;
        flex-wrap: wrap;
        padding: 0 0.35rem;
    }
    .rep-top h1 {
        margin: 0;
        font-size: clamp(1.7rem, 2.8vw, 2.2rem);
        font-weight: 600;
        letter-spacing: -0.01em;
        line-height: 1.1;
    }
    .rep-acciones {
        display: flex;
        align-items: center;
        gap: 1rem;
        flex-wrap: wrap;
    }
    .rep-link {
        border: 0;
        background: none;
        font: inherit;
        font-size: 0.95rem;
        color: var(--tinta-suave);
        text-decoration: underline;
        text-underline-offset: 4px;
        cursor: pointer;
        padding: 0.4rem 0.2rem;
    }
    .rep-link:hover {
        color: var(--tinta);
    }
    .btn-regresar {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        box-sizing: border-box;
        text-decoration: none;
        font-family: inherit;
        font-size: 1.02rem;
        color: var(--tinta);
        border: 1.5px solid var(--linea);
        border-radius: 999px;
        background: rgba(255, 255, 255, 0.66);
        padding: 0.72rem 2.2rem;
        cursor: pointer;
        white-space: nowrap;
        transition:
            background 160ms ease,
            transform 160ms ease;
    }
    .btn-regresar:hover {
        background: #fff;
    }
    .btn-regresar:active {
        transform: translateY(1px);
    }
    .menu-wrap {
        position: relative;
    }
    .menu {
        position: absolute;
        right: 0;
        top: calc(100% + 0.5rem);
        z-index: 30;
        min-width: 220px;
        background: #fff;
        border: 1.5px solid var(--linea);
        border-radius: 18px;
        padding: 0.5rem;
        box-shadow: 0 18px 40px rgba(23, 30, 38, 0.14);
    }
    .menu p {
        margin: 0.2rem 0.6rem 0.5rem;
        font-size: 0.7rem;
        text-transform: uppercase;
        letter-spacing: 0.09em;
        color: var(--tinta-suave);
    }
    .menu button {
        display: block;
        width: 100%;
        text-align: left;
        border: 0;
        background: transparent;
        font: inherit;
        font-size: 0.95rem;
        color: var(--tinta);
        padding: 0.55rem 0.6rem;
        border-radius: 10px;
        cursor: pointer;
    }
    .menu button:hover {
        background: var(--acento-suave);
    }

    /* ---------- Estructura ---------- */
    .rep-layout {
        max-width: 1500px;
        margin: 0 auto;
        display: grid;
        grid-template-columns: minmax(230px, 290px) minmax(0, 1fr);
        gap: clamp(1rem, 2vw, 1.6rem);
        align-items: start;
    }
    .rep-main {
        display: flex;
        flex-direction: column;
        gap: clamp(1rem, 2vw, 1.5rem);
        min-width: 0;
    }
    .vista {
        display: flex;
        flex-direction: column;
        gap: clamp(1rem, 2vw, 1.5rem);
        animation: rep-aparecer 220ms ease both;
    }
    @keyframes rep-aparecer {
        from {
            opacity: 0;
            transform: translateY(4px);
        }
    }
    .vista-cab {
        display: flex;
        justify-content: space-between;
        align-items: flex-end;
        gap: 1rem;
        flex-wrap: wrap;
        padding: 0.2rem 0.35rem;
    }
    .vista-cab h2 {
        margin: 0;
        font-size: clamp(1.35rem, 2.2vw, 1.8rem);
        font-weight: 600;
        letter-spacing: -0.01em;
    }
    .vista-sub {
        margin: 0.35rem 0 0;
        color: var(--tinta-suave);
        font-size: 0.9rem;
        line-height: 1.5;
    }
    .vista-acciones {
        display: flex;
        gap: 0.5rem;
        flex-wrap: wrap;
    }

    /* ---------- Botones ---------- */
    .btn {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 0.4rem;
        font: inherit;
        font-size: 0.88rem;
        font-weight: 500;
        padding: 0.55rem 1.05rem;
        border-radius: 999px;
        border: 1px solid var(--linea);
        background: rgba(255, 255, 255, 0.65);
        color: var(--tinta);
        cursor: pointer;
        text-decoration: none;
        white-space: nowrap;
        transition:
            background 150ms ease,
            transform 150ms ease,
            border-color 150ms ease;
    }
    .btn:hover {
        background: #fff;
    }
    .btn:active {
        transform: translateY(1px);
    }
    .btn-primario {
        background: var(--tinta);
        border-color: var(--tinta);
        color: #fff;
    }
    .btn-primario:hover {
        background: #38424d;
    }
    .btn-fantasma {
        background: transparent;
        border-color: var(--linea-tenue);
        color: var(--tinta-suave);
    }
    .btn-fantasma:hover {
        background: transparent;
        border-color: var(--linea);
        color: var(--tinta);
    }
    .btn-chico {
        padding: 0.35rem 0.85rem;
        font-size: 0.78rem;
    }

    /* ---------- Panel lateral ---------- */
    .rep-aside {
        position: sticky;
        top: 1.2rem;
        display: flex;
        flex-direction: column;
        gap: 1.5rem;
        border: 1.5px solid var(--linea);
        border-radius: 30px;
        background: rgba(255, 255, 255, 0.56);
        backdrop-filter: blur(4px);
        padding: 1.6rem 1.15rem 1.4rem;
    }
    .nav-metricas {
        display: flex;
        flex-direction: column;
        gap: 0.2rem;
    }
    .nav-item {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 0.6rem;
        width: 100%;
        border: 0;
        background: transparent;
        font: inherit;
        font-size: 1rem;
        color: var(--tinta);
        padding: 0.62rem 0.8rem;
        border-radius: 999px;
        cursor: pointer;
        text-align: left;
        transition:
            background 150ms ease,
            color 150ms ease;
    }
    .nav-item:hover {
        background: rgba(255, 255, 255, 0.85);
    }
    .nav-item[aria-current="true"] {
        background: var(--acento-suave);
        font-weight: 600;
    }
    .nav-cuenta {
        flex: 0 0 auto;
        min-width: 1.55rem;
        padding: 0.1rem 0.4rem;
        border-radius: 999px;
        background: rgba(255, 255, 255, 0.9);
        color: var(--tinta-suave);
        font-size: 0.72rem;
        font-weight: 600;
        text-align: center;
        font-variant-numeric: tabular-nums;
    }
    .nav-item[aria-current="true"] .nav-cuenta {
        color: var(--acento);
    }
    .nav-separador {
        height: 1px;
        border: 0;
        background: var(--linea-tenue);
        margin: 0.55rem 0.3rem;
    }
    .aside-nota {
        margin: auto 0 0;
        padding-top: 1rem;
        border-top: 1px dashed var(--linea-tenue);
        font-size: 0.74rem;
        line-height: 1.55;
        color: var(--tinta-suave);
    }

    /* ---------- Paneles ---------- */
    .panel {
        border: 1.5px solid var(--linea);
        border-radius: clamp(22px, 2.4vw, 30px);
        background: var(--papel);
        padding: clamp(1.1rem, 1.8vw, 1.6rem);
    }
    .panel-cab {
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 1rem;
        flex-wrap: wrap;
        margin-bottom: 0.9rem;
    }
    .panel-cab h3 {
        margin: 0;
        font-size: 1rem;
        font-weight: 600;
    }
    .panel-cab-acciones {
        display: flex;
        align-items: center;
        gap: 0.7rem;
        flex-wrap: wrap;
    }
    .panel-nota {
        font-size: 0.78rem;
        color: var(--tinta-suave);
        font-variant-numeric: tabular-nums;
    }
    .panel-grafica {
        padding-bottom: clamp(1rem, 1.8vw, 1.5rem);
    }
    .vacio {
        margin: 0;
        padding: clamp(1.6rem, 4vw, 3rem) 1rem;
        text-align: center;
        color: var(--tinta-suave);
        font-size: 0.92rem;
        line-height: 1.6;
        border: 1px dashed var(--linea-tenue);
        border-radius: 20px;
        background: rgba(255, 255, 255, 0.4);
    }
    .vacio-tabla {
        margin: 0.4rem 0 0;
        font-size: 0.85rem;
        color: var(--tinta-suave);
    }

    /* ---------- Gráfica ---------- */
    .grafica {
        width: 100%;
        margin-top: 0.2rem;
    }
    .grafica svg {
        display: block;
        width: 100%;
        height: auto;
        overflow: visible;
    }
    .grafica text {
        font-family: inherit;
    }

    /* ---------- Tabla ---------- */
    .tabla-wrap {
        overflow-x: auto;
        border-radius: 14px;
    }
    .tabla-datos {
        width: 100%;
        border-collapse: collapse;
        font-size: 0.9rem;
    }
    .tabla-datos th {
        text-align: left;
        padding: 0.55rem 0.6rem;
        border-bottom: 1px solid var(--linea-tenue);
        color: var(--tinta-suave);
        font-size: 0.7rem;
        font-weight: 600;
        letter-spacing: 0.08em;
        text-transform: uppercase;
        white-space: nowrap;
    }
    .tabla-datos td {
        padding: 0.62rem 0.6rem;
        border-bottom: 1px solid rgba(213, 219, 225, 0.7);
        color: var(--tinta);
        white-space: nowrap;
    }
    .tabla-datos tbody tr:last-child td {
        border-bottom: 0;
    }
    .tabla-datos .num {
        font-weight: 600;
        font-variant-numeric: tabular-nums;
    }
    .cambio {
        font-size: 0.8rem;
        font-weight: 600;
        color: var(--tinta-suave);
        font-variant-numeric: tabular-nums;
    }
    .cambio.sube {
        color: #1a7f4b;
    }
    .cambio.baja {
        color: #b4443b;
    }
    .btn-eliminar {
        border: 0;
        background: transparent;
        color: var(--tinta-suave);
        font: inherit;
        font-size: 0.78rem;
        padding: 0.25rem 0.45rem;
        border-radius: 7px;
        cursor: pointer;
    }
    .btn-eliminar:hover {
        color: #b4443b;
        background: rgba(180, 68, 59, 0.08);
    }

    /* ---------- Formulario manual ---------- */
    .form-manual {
        display: flex;
        flex-wrap: wrap;
        align-items: flex-end;
        gap: 0.75rem;
        padding: 1rem 1.1rem;
        border: 1.5px dashed var(--linea);
        border-radius: 22px;
        background: rgba(255, 255, 255, 0.55);
    }
    .form-manual label {
        display: flex;
        flex-direction: column;
        gap: 0.3rem;
        font-size: 0.72rem;
        font-weight: 600;
        letter-spacing: 0.06em;
        text-transform: uppercase;
        color: var(--tinta-suave);
    }
    .form-manual input {
        font: inherit;
        font-size: 0.95rem;
        font-weight: 400;
        letter-spacing: normal;
        text-transform: none;
        color: var(--tinta);
        background: #fff;
        border: 1px solid var(--linea-tenue);
        border-radius: 10px;
        padding: 0.5rem 0.7rem;
    }
    .form-manual input[type="number"] {
        width: 9.5rem;
    }
    .form-ayuda {
