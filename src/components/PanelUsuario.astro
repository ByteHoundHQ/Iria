---
import SelectorCirculos from "./SelectorCirculos.astro";
---

<section data-vista-panel hidden>
    <SelectorCirculos />
</section>

<script is:inline>
    try {
        if (sessionStorage.getItem("iria_auth") === "true") {
            document
                .querySelector("[data-vista-panel]")
                ?.removeAttribute("hidden");
        } else {
            window.location.replace("/");
        }
    } catch {
        window.location.replace("/");
    }

    document.getElementById("boton-regresar")?.addEventListener("click", () => {
        try {
            sessionStorage.removeItem("iria_auth");
            sessionStorage.removeItem("iria_user");
        } catch {}
        window.dispatchEvent(new CustomEvent("iria:auth-change"));
        window.location.href = "/";
    });
</script>
