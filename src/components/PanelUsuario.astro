---
import SelectorCirculos from "./SelectorCirculos.astro";
---

<section data-vista-panel hidden>
    <SelectorCirculos />
</section>

<script>
    import { cerrarSesion, obtenerSesion } from "../lib/auth.ts";

    const panel = document.querySelector("[data-vista-panel]");

    try {
        if (await obtenerSesion()) {
            panel?.removeAttribute("hidden");
        } else {
            window.location.replace("/");
        }
    } catch {
        window.location.replace("/");
    }

    document.getElementById("boton-regresar")?.addEventListener("click", async (event) => {
        event.preventDefault();
        try {
            await cerrarSesion();
        } catch {}
        window.dispatchEvent(new CustomEvent("iria:auth-change"));
        window.location.href = "/";
    });
</script>
