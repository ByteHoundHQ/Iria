---
interface Opcion {
    id: string;
    etiqueta: string;
    href?: string;
}

interface Props {
    titulo?: string;
    etiquetaBoton?: string;
    opciones?: Opcion[];
    variante?: "clasico" | "connect" | "create";
}

const {
    titulo = "Text",
    etiquetaBoton = "Button Communicate",
    opciones = [
        { id: "tareas", etiqueta: "Tareas" },
        { id: "calendario", etiqueta: "Calendario mensual" },
        { id: "aprobaciones", etiqueta: "Aprobaciones" },
    ],
    variante = "clasico",
} = Astro.props;

const esConnect = variante === "connect";
const esCreate = variante === "create";
const esTarjeta = esConnect || esCreate;
---

<section
    class:list={[
        "ind",
        esTarjeta && "ind--tarjeta",
        esConnect && "ind--connect",
        esCreate && "ind--create",
    ]}
>
    {
        esTarjeta ? (
            <h1 class="ind-titulo-oculto">{titulo}</h1>
        ) : (
            <header class="ind-top">
                <h1>{titulo}</h1>
            </header>
        )
    }

    <div class="ind-card">
        <div class="ind-body">
            <div class="ind-left">
                <button type="button" class="ind-circle" id="boton-comunicar">
                    <span>{etiquetaBoton}</span>
                </button>
            </div>

            {
                esTarjeta && (
                    <svg
                        class="ind-conectores"
                        viewBox="0 0 220 280"
                        preserveAspectRatio="none"
                        fill="none"
                        aria-hidden="true"
                    >
                        {esCreate ? (
                            <>
                                <path
                                    d="M0 60H65C76 60 85 51 85 40V20C85 9 94 0 105 0H220"
                                    stroke="#141414"
                                    stroke-width="2.5"
                                    vector-effect="non-scaling-stroke"
                                />
                                <path
                                    d="M0 140H220"
                                    stroke="#141414"
                                    stroke-width="2.5"
                                    vector-effect="non-scaling-stroke"
                                />
                                <path
                                    d="M0 220H65C76 220 85 229 85 240V260C85 271 94 280 105 280H220"
                                    stroke="#141414"
                                    stroke-width="2.5"
                                    vector-effect="non-scaling-stroke"
                                />
                            </>
                        ) : (
                            <>
                                <path
                                    d="M0 70H70C81 70 90 61 90 50V20C90 9 99 0 110 0H220"
                                    stroke="#141414"
                                    stroke-width="2.5"
                                    vector-effect="non-scaling-stroke"
                                />
                                <path
                                    d="M0 210H70C81 210 90 219 90 230V260C90 271 99 280 110 280H220"
                                    stroke="#141414"
                                    stroke-width="2.5"
                                    vector-effect="non-scaling-stroke"
                                />
                            </>
                        )}
                    </svg>
                )
            }

            <nav class="ind-right" aria-label="Secciones">
                <ul>
                    {
                        opciones.map((op) => (
                            <li>
                                {op.href ? (
                                    <a
                                        href={op.href}
                                        class="opcion"
                                        data-seccion={op.id}
                                        data-astro-prefetch="viewport"
                                    >
                                        {op.etiqueta}
                                    </a>
                                ) : (
                                    <button
                                        type="button"
                                        class="opcion"
                                        data-seccion={op.id}
                                    >
                                        {op.etiqueta}
                                    </button>
                                )}
                            </li>
                        ))
                    }
                </ul>
            </nav>
        </div>

        <footer class="ind-foot">
            <a
                href="/seleccion"
                id="boton-volver"
                class="btn-regresar"
                data-astro-prefetch="viewport"
                data-cursor-carga
            >
                {
                    esTarjeta && (
                        <svg
                            class="btn-regresar-flecha"
                            viewBox="0 0 24 24"
                            aria-hidden="true"
                        >
                            <path d="M15 5 8 12l7 7" />
                        </svg>
                    )
                }
                Regresar
            </a>
        </footer>
    </div>
</section>

<script>
    document.getElementById("boton-comunicar")?.addEventListener("click", () => {
        window.dispatchEvent(new CustomEvent("iria:comunicar"));
    });

    document.querySelectorAll("[data-seccion]").forEach((el) => {
        el.addEventListener("click", () => {
            const target = el as HTMLElement;
            const seccion = target.dataset.seccion ?? "";
            window.dispatchEvent(
                new CustomEvent("iria:seccion", { detail: seccion }),
            );
        });
    });
</script>

<style>
    .ind {
        min-height: 100vh;
        display: flex;
        flex-direction: column;
        background: #f1f5f9;
        box-sizing: border-box;
    }
    /* En la variante clásica la tarjeta no existe visualmente. */
    .ind-card {
        display: contents;
    }
    .ind-titulo-oculto {
        position: absolute;
        width: 1px;
        height: 1px;
        margin: -1px;
        padding: 0;
        overflow: hidden;
        clip: rect(0 0 0 0);
        clip-path: inset(50%);
        white-space: nowrap;
        border: 0;
    }
    .ind-top {
        background: #fff;
        border-bottom: 1px solid #e2e8f0;
        padding: 2rem 1rem;
        text-align: center;
    }
    .ind-top h1 {
        margin: 0;
        font-size: 1.75rem;
        font-weight: 800;
        letter-spacing: 0.05em;
        color: #0f172a;
    }
    .ind-body {
        flex: 1;
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 4rem;
        padding: 2rem;
        box-sizing: border-box;
    }
    .ind-left {
        flex: 0 0 auto;
    }
    .ind-circle {
        width: 300px;
        height: 300px;
        border-radius: 50%;
        border: 1px solid #cbd5e1;
        background: #fff;
        color: #0f172a;
        font-size: 1.25rem;
        font-weight: 600;
        cursor: pointer;
        display: grid;
        place-items: center;
        padding: 2rem;
    }
    .ind-circle:hover {
        background: #f8fafc;
    }
    .ind-right ul {
        list-style: none;
        margin: 0;
        padding: 0;
        display: flex;
        flex-direction: column;
        gap: 1rem;
        width: 100%;
        max-width: 320px;
    }
    .opcion {
        display: block;
        width: 100%;
        box-sizing: border-box;
        text-align: left;
        text-decoration: none;
        font-family: inherit;
        padding: 0.8rem 1rem;
        border: 1px solid #cbd5e1;
        border-radius: 6px;
        background: #fff;
        color: #0f172a;
        font-size: 1rem;
        font-weight: 600;
        cursor: pointer;
    }
    .opcion:hover {
        background: #f8fafc;
        border-color: #0f172a;
    }
    .ind-foot {
        display: flex;
        justify-content: flex-end;
        padding: 1.5rem 2rem 2rem;
    }
    .btn-regresar {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        box-sizing: border-box;
        text-decoration: none;
        font-family: inherit;
        border: none;
        border-radius: 6px;
        background: #0f172a;
        color: #fff;
        padding: 0.6rem 2rem;
        font-size: 1rem;
        cursor: pointer;
    }
    .btn-regresar:hover {
        background: #1e293b;
    }

    /* ---------- Variantes con tarjeta crema sobre fondo vino ---------- */
    .ind--tarjeta {
        justify-content: center;
        align-items: center;
        background: #6e0d0d;
        padding: clamp(1rem, 3vw, 2.5rem);
    }
    .ind--tarjeta .ind-card {
        display: flex;
        flex-direction: column;
        justify-content: space-between;
        width: min(1120px, 100%);
        min-height: min(560px, calc(100vh - clamp(2rem, 6vw, 5rem)));
        padding: clamp(1.75rem, 4.5vw, 4.25rem);
        border-radius: clamp(28px, 3.5vw, 44px);
        background: #f5efe4;
        box-sizing: border-box;
        box-shadow: 0 26px 60px rgba(0, 0, 0, 0.28);
    }
    .ind--tarjeta .ind-body {
        flex: 1;
        display: grid;
        grid-template-columns:
            minmax(0, 0.95fr) minmax(70px, 0.55fr)
            minmax(0, 1.2fr);
        align-items: center;
        justify-content: initial;
        gap: clamp(1rem, 2.5vw, 2.5rem);
        padding: 0;
    }
    .ind--tarjeta .ind-left {
        display: flex;
        justify-content: center;
    }
    .ind--tarjeta .ind-circle {
        width: min(315px, 100%);
        height: auto;
        aspect-ratio: 1;
        border: 0;
        font-weight: 700;
        padding: 1rem;
        transition: filter 160ms ease;
    }
    .ind--tarjeta .ind-circle:hover {
        filter: brightness(0.96);
    }
    .ind--tarjeta .ind-conectores {
        width: 100%;
        max-width: 230px;
        height: clamp(150px, 20vw, 260px);
        justify-self: center;
    }
    .ind--tarjeta .ind-right ul {
        gap: clamp(0.7rem, 1.2vw, 1.05rem);
        width: 100%;
        max-width: none;
        align-items: flex-start;
    }
    .ind--tarjeta .opcion {
        width: auto;
        padding: 0.1rem 0;
        border: 0;
        border-radius: 0;
        background: transparent;
        color: #141414;
        font-size: clamp(1.05rem, 1.6vw, 1.45rem);
        font-weight: 700;
        line-height: 1.2;
        transition:
            color 160ms ease,
            transform 160ms ease;
    }
    .ind--tarjeta .opcion:hover {
        background: transparent;
        border-color: transparent;
        color: #6e0d0d;
        transform: translateX(4px);
    }
    .ind--tarjeta .ind-foot {
        justify-content: flex-start;
        padding: 0;
    }
    .ind--tarjeta .btn-regresar {
        gap: 0.5rem;
        border: 0;
        border-radius: 999px;
        background: #6e0d0d;
        color: #fff6e3;
        padding: 0.55rem 1.6rem 0.55rem 1.05rem;
        font-weight: 700;
        transition:
            background 160ms ease,
            transform 160ms ease;
    }
    .ind--tarjeta .btn-regresar:hover {
        background: #8a1414;
    }
    .ind--tarjeta .btn-regresar:active {
        transform: scale(0.98);
    }
    .btn-regresar-flecha {
        width: 1.1rem;
        height: 1.1rem;
        flex: 0 0 auto;
    }
    .btn-regresar-flecha path {
        fill: none;
        stroke: currentColor;
        stroke-width: 3;
        stroke-linecap: round;
        stroke-linejoin: round;
    }

    /* Connect: círculo azul claro. */
    .ind--connect .ind-circle {
        background: #cfe4ec;
        color: #1b1b1b;
        font-size: clamp(1.75rem, 3.6vw, 3rem);
    }
    .ind--connect .ind-circle:hover {
        background: #cfe4ec;
    }

    /* Create: círculo amarillo pálido con texto vino. */
    .ind--create .ind-circle {
        background: #fdf3c8;
        color: #6e0d0d;
        font-size: clamp(2rem, 4vw, 3.4rem);
    }
    .ind--create .ind-circle:hover {
        background: #fdf3c8;
    }
    .ind--create .ind-conectores {
        max-width: 240px;
        height: clamp(180px, 21vw, 260px);
    }
    .ind--create .ind-right ul {
        gap: clamp(1.3rem, 2.6vw, 2.2rem);
    }
    .ind--create .opcion {
        font-size: clamp(1.15rem, 1.9vw, 1.65rem);
    }
    @media (max-width: 820px) {
        .ind-body {
            flex-direction: column;
            gap: 2rem;
        }
        .ind-circle {
            width: 230px;
            height: 230px;
            font-size: 1.15rem;
        }
        .ind-right ul {
            max-width: 100%;
        }
        .ind-foot {
            justify-content: center;
        }
        .ind--tarjeta .ind-body {
            grid-template-columns: minmax(0, 1fr);
            gap: 1.5rem;
        }
        .ind--tarjeta .ind-conectores {
            display: none;
        }
        .ind--tarjeta .ind-card {
            min-height: auto;
            gap: 1.75rem;
        }
        .ind--tarjeta .ind-circle {
            width: min(220px, 100%);
        }
    }
</style>
