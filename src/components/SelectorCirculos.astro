---
---

<div class="sel-min">
    <div class="tarjeta">
        <div class="circulos" role="group" aria-label="Opciones de selección">
            <a
                href="/ind_1"
                class="circulo circulo-communicate"
                data-btn="Btn1"
                data-astro-prefetch
            >
                <span>Communicate</span>
            </a>
            <a
                href="/ind_3"
                class="circulo circulo-create"
                data-btn="Btn3"
                data-astro-prefetch
            >
                <span>Create</span>
            </a>
            <a
                href="/ind_2"
                class="circulo circulo-connect"
                data-btn="Btn2"
                data-astro-prefetch
            >
                <span>Connect</span>
            </a>
        </div>
        <div class="pregunta">
            <h1>
                ¿En qué te
                <br />
                enfocarás hoy?
            </h1>
        </div>
    </div>
    <a
        href="/"
        id="boton-regresar"
        class="btn-regresar"
        data-astro-prefetch="viewport"
        data-cursor-carga
    >
        Regresar
    </a>
</div>

<script>
    import { prefetch } from "astro:prefetch";
    import { activarCursorCarga } from "../lib/cursorCarga";

    const grupo = document.querySelector<HTMLElement>(".circulos");
    const botones = document.querySelectorAll<HTMLAnchorElement>("[data-btn]");

    const marcarSeleccion = (boton: HTMLAnchorElement) => {
        grupo?.classList.add("circulos--cargando");
        boton.classList.add("circulo--cargando");
    };

    const activarCarga = (boton: HTMLAnchorElement) => {
        if (activarCursorCarga(boton)) marcarSeleccion(boton);
    };

    botones.forEach((boton) => {
        boton.addEventListener("pointerdown", (event) => {
            if (
                event.button !== 0 ||
                event.metaKey ||
                event.ctrlKey ||
                event.shiftKey ||
                event.altKey
            ) {
                return;
            }
            activarCarga(boton);
        });

        boton.addEventListener("click", (event) => {
            // event.detail === 0 indica activación por teclado.
            if (event.detail === 0) activarCarga(boton);

            const nombre = boton.getAttribute("data-btn") ?? "opción";
            window.dispatchEvent(
                new CustomEvent("iria:seleccion", { detail: nombre }),
            );
        });
    });

    // Al volver con el botón "atrás" (bfcache) se limpia el estado visual.
    window.addEventListener("pageshow", () => {
        grupo?.classList.remove("circulos--cargando");
        botones.forEach((boton) => boton.classList.remove("circulo--cargando"));
    });

    const destinos = Array.from(botones)
        .map((boton) => boton.getAttribute("href"))
        .filter((href): href is string => Boolean(href));

    const precargarDestinos = () => {
        destinos.forEach((destino) => prefetch(destino));
    };

    if (typeof window.requestIdleCallback === "function") {
        window.requestIdleCallback(precargarDestinos, { timeout: 1000 });
    } else {
        window.setTimeout(precargarDestinos, 300);
    }
</script>

<style>
    .sel-min {
        min-height: 100vh;
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        gap: 1.5rem;
        background: #6e0d0d;
        padding: clamp(1rem, 3vw, 2.5rem);
        box-sizing: border-box;
    }

    .tarjeta {
        width: min(1280px, 100%);
        display: grid;
        grid-template-columns: minmax(0, 1.05fr) minmax(0, 1fr);
        align-items: center;
        gap: clamp(1.5rem, 3.5vw, 3.5rem);
        padding: clamp(1.5rem, 4vw, 3.5rem) clamp(1.5rem, 3.5vw, 3.5rem);
        border-radius: clamp(24px, 3.2vw, 40px);
        background: #f5efe4;
        box-sizing: border-box;
        box-shadow: 0 26px 60px rgba(0, 0, 0, 0.28);
        container-type: inline-size;
    }

    .circulos {
        position: relative;
        width: 100%;
        max-width: 600px;
        aspect-ratio: 521 / 432;
        justify-self: center;
        container-type: inline-size;
    }

    .circulo {
        position: absolute;
        width: 52.7%;
        aspect-ratio: 1;
        border: 0;
        border-radius: 50%;
        padding: 0;
        display: grid;
        place-items: center;
        font-family: inherit;
        font-size: clamp(1rem, 5.7cqw, 2rem);
        font-weight: 700;
        line-height: 1;
        letter-spacing: -0.02em;
        text-decoration: none;
        cursor: pointer;
        transition:
            filter 180ms ease,
            box-shadow 180ms ease;
    }

    .circulo:active {
        filter: brightness(0.94);
    }

    .circulo:focus-visible {
        outline: 3px solid #6e0d0d;
        outline-offset: 4px;
    }

    .circulo span {
        padding: 0.18em 0.6em;
        border-radius: 999px;
        transition:
            background 180ms ease,
            color 180ms ease;
    }

    .circulo:hover {
        box-shadow: inset 0 0 0 clamp(3px, 1.5cqw, 6px) var(--anillo);
    }

    .circulo:hover span {
        background: var(--anillo);
        color: var(--texto-anillo);
    }

    /* Al pasar el mouse, los demás se atenúan sin moverse ni cambiar de capa. */
    .circulos:has(.circulo:hover) .circulo:not(:hover) {
        filter: saturate(0.55) brightness(0.92);
    }

    .circulo-communicate {
        --anillo: #f5efe4;
        --texto-anillo: #3b2a1a;
        left: 0;
        top: 0;
        z-index: 1;
        background: #3b2a1a;
        color: #fff8ef;
    }

    .circulo-create {
        --anillo: #6e0d0d;
        --texto-anillo: #faf4c6;
        left: 47.4%;
        top: 3.5%;
        z-index: 2;
        background: #faf4c6;
        color: #6e0d0d;
    }

    .circulo-connect {
        --anillo: #3b2a1a;
        --texto-anillo: #cfe4ec;
        left: 27.4%;
        top: 36.8%;
        z-index: 3;
        background: #cfe4ec;
        color: #141414;
    }

    .pregunta {
        display: grid;
        place-items: center;
    }

    .pregunta h1 {
        margin: 0;
        color: #0b0b0b;
        font-size: clamp(2.4rem, 5vw, 4.75rem);
        font-size: clamp(2.35rem, 5.8cqw, 4.75rem);
        font-weight: 900;
        line-height: 0.98;
        letter-spacing: -0.045em;
        text-align: center;
    }

    .btn-regresar {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        box-sizing: border-box;
        text-decoration: none;
        font-family: inherit;
        border: 1.5px solid rgba(255, 246, 227, 0.55);
        border-radius: 999px;
        background: transparent;
        color: #fff6e3;
        padding: 0.65rem 2.2rem;
        font-size: 1rem;
        font-weight: 600;
        cursor: pointer;
        transition:
            background 180ms ease,
            color 180ms ease;
    }

    .btn-regresar:hover {
        background: #fff6e3;
        color: #6e0d0d;
        border-color: #fff6e3;
    }

    .btn-regresar:focus-visible {
        outline: 3px solid #fff6e3;
        outline-offset: 4px;
    }

    /* El círculo elegido conserva su estado de selección. */
    .circulo--cargando {
        box-shadow: inset 0 0 0 clamp(3px, 1.5cqw, 6px) var(--anillo);
    }

    .circulo--cargando span {
        background: var(--anillo);
        color: var(--texto-anillo);
    }

    .circulos--cargando .circulo:not(.circulo--cargando) {
        filter: saturate(0.55) brightness(0.92);
    }

    @media (max-width: 860px) {
        .tarjeta {
            grid-template-columns: minmax(0, 1fr);
            gap: 1.75rem;
            padding: clamp(1.25rem, 5vw, 2.5rem);
        }

        .circulos {
            max-width: 460px;
        }

        .pregunta h1 {
            font-size: clamp(2rem, 9vw, 3.25rem);
        }
    }

    @media (prefers-reduced-motion: reduce) {
        .circulo,
        .btn-regresar {
            transition: none;
        }
    }
</style>
