---

---

<div class="login-layout" data-vista-login>
    <div class="login-left">
        <h1 class="brand">IRIA</h1>
        <p class="tagline">Connect. Create. Communicate.</p>
    </div>

    <div class="login-right">
        <h2 class="welcome">Welcome!</h2>
        <p class="welcome-sub">Enter Your Details Below</p>

        <div class="card-outer">
            <div class="card-inner">
                <svg
                    class="card-bg"
                    viewBox="0 0 400 600"
                    preserveAspectRatio="none"
                    aria-hidden="true"
                >
                    <path
                        d="M0,238 C0,200 16,188 42,183 C68,178 78,172 88,150 L106,98 C112,82 122,68 144,68 L400,68 L400,600 L0,600 Z"
                        fill="#ffffff"></path>
                </svg>

                <form id="login-form">
                    <label for="email">Email</label>
                    <input
                        id="email"
                        name="email"
                        type="email"
                        autocomplete="username"
                        required
                    />

                    <label for="password">Password</label>
                    <input
                        id="password"
                        name="password"
                        type="password"
                        autocomplete="current-password"
                        required
                    />

                    <div class="btn-group">
                        <button type="submit" id="btn-submit">Log In</button>
                        <button type="button" id="btn-signup">Sign Up</button>
                    </div>

                    <p id="form-feedback"></p>
                </form>
            </div>
        </div>
    </div>
</div>

<script>
    import {
        cerrarSesion,
        credencialesConfiguradas,
        iniciarSesion,
    } from "../lib/auth.ts";

    cerrarSesion();

    const form = document.getElementById("login-form") as HTMLFormElement | null;
    const emailInput = document.getElementById(
        "email",
    ) as HTMLInputElement | null;
    const passInput = document.getElementById(
        "password",
    ) as HTMLInputElement | null;
    const feedback = document.getElementById("form-feedback");
    const signupBtn = document.getElementById("btn-signup");

    form?.addEventListener("submit", (e) => {
        e.preventDefault();
        if (feedback) feedback.textContent = "";

        const email = emailInput?.value.trim() ?? "";
        const password = passInput?.value ?? "";

        if (!email || !password) {
            if (feedback) feedback.textContent = "Completa correo y contraseña.";
            return;
        }

        if (!credencialesConfiguradas()) {
            if (feedback) feedback.textContent = "Error: .env no configurado";
            return;
        }

        if (iniciarSesion(email, password)) {
            window.location.href = "/seleccion";
        } else {
            if (feedback)
                feedback.textContent = "Correo o contraseña incorrectos.";
        }
    });

    signupBtn?.addEventListener("click", () => {
        if (feedback) feedback.textContent = "El registro está deshabilitado.";
    });
</script>

<style>
    .login-layout {
        display: flex;
        min-height: 100vh;
        background: #6e0d0d;
        font-family:
            system-ui,
            -apple-system,
            "Segoe UI",
            Roboto,
            sans-serif;
    }
    .login-left {
        flex: 1.1;
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        padding: 2rem;
    }
    .brand {
        margin: 0;
        color: #fff8c9;
        font-weight: 900;
        font-size: clamp(6rem, 17vw, 13rem);
        line-height: 0.9;
        letter-spacing: -0.02em;
        font-stretch: condensed;
    }
    .tagline {
        margin: 0.8rem 0 0;
        color: #fff;
        font-weight: 700;
        font-size: 1.25rem;
        letter-spacing: -0.01em;
    }
    .login-right {
        flex: 1;
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        padding: 3rem 2rem;
    }
    .welcome {
        margin: 0;
        color: #fff6e3;
        font-size: clamp(2.2rem, 4vw, 3.4rem);
        font-weight: 800;
        letter-spacing: 0.01em;
    }
    .welcome-sub {
        margin: 0.4rem 0 1.6rem;
        color: #fff;
        font-weight: 700;
        font-size: 1.15rem;
    }
    .card-outer {
        width: 100%;
        max-width: 580px;
        padding: 16px;
        border-radius: 32px;
        background: linear-gradient(
            135deg,
            #fff4b9 0%,
            #fff9de 12%,
            #7a1414 30%,
            #5e0d0d 37%,
            #8ca0a6 60%,
            #d2dfe0 78%,
            #4a2b15 100%
        );
        box-shadow: 0 20px 60px rgba(0, 0, 0, 0.35);
    }
    .card-inner {
        position: relative;
        border-radius: 22px;
        overflow: hidden;
        background: linear-gradient(
            100deg,
            #fff2ad 0%,
            #fff6cc 32%,
            #fdf6e3 48%,
            #eef1f1 70%,
            #dfe8e9 100%
        );
        min-height: 480px;
    }
    .card-bg {
        position: absolute;
        inset: 0;
        width: 100%;
        height: 100%;
        display: block;
    }
    #login-form {
        position: relative;
        z-index: 2;
        padding: 185px 2.8rem 1.8rem;
        display: flex;
        flex-direction: column;
    }
    #login-form label {
        font-weight: 800;
        font-size: 1.05rem;
        color: #111;
        margin: 0 0 0.35rem;
    }
    #login-form input {
        border: none;
        border-bottom: 1.5px solid #4b4b4b;
        padding: 0.5rem 0.15rem 0.55rem;
        margin-bottom: 1.7rem;
        font-size: 1rem;
        outline: none;
        background: transparent;
        border-radius: 0;
    }
    #login-form input:focus {
        border-bottom-color: #6e0d0d;
    }
    .btn-group {
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: 0.7rem;
        margin-top: 0.4rem;
    }
    .btn-group button {
        width: 230px;
        padding: 0.65rem;
        border: none;
        border-radius: 999px;
        background: #3f2412;
        color: #fff;
        font-size: 1.05rem;
        font-weight: 500;
        cursor: pointer;
    }
    .btn-group button:hover {
        background: #2f1b0d;
    }
    #form-feedback {
        min-height: 1.2em;
        font-size: 0.9rem;
        color: #b91c1c;
        text-align: center;
        margin: 0.9rem 0 0;
    }

    @media (max-width: 900px) {
        .login-layout {
            flex-direction: column;
        }
        .login-left {
            padding: 3rem 1rem 0;
        }
        .brand {
            font-size: clamp(4.5rem, 22vw, 7rem);
        }
        .login-right {
            padding: 2rem 1.2rem 3rem;
        }
    }
</style>
