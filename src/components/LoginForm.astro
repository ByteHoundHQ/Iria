---
---

<div class="login-layout" data-vista-login>
    <!-- Lado izquierdo: Logotipo -->
    <div class="login-left">
        <div class="logo-placeholder">
            <!-- Reemplaza por <img src="/logo.svg" alt="IRIA" /> cuando tengas el logo -->
            <span>IRIA</span>
            <p>Logotipo</p>
        </div>
    </div>

    <!-- Lado derecho: Credenciales -->
    <div class="login-right">
        <form id="login-form">
            <h2>Iniciar sesión</h2>

            <label for="email">Correo</label>
            <input
                id="email"
                name="email"
                type="email"
                autocomplete="username"
                placeholder="correo@ejemplo.com"
                required
            />

            <label for="password">Contraseña</label>
            <input
                id="password"
                name="password"
                type="password"
                autocomplete="current-password"
                placeholder="••••••••"
                required
            />

            <button type="submit" id="btn-submit">Entrar</button>

            <p id="form-feedback"></p>
        </form>
    </div>
</div>

<script>
    import {
        cerrarSesion,
        credencialesConfiguradas,
        iniciarSesion,
    } from "../lib/auth.ts";

    // La página de login siempre arranca sin sesión:
    // solo se entra con credenciales recién validadas.
    cerrarSesion();

    const form = document.getElementById("login-form") as HTMLFormElement | null;
    const emailInput = document.getElementById(
        "email",
    ) as HTMLInputElement | null;
    const passInput = document.getElementById(
        "password",
    ) as HTMLInputElement | null;
    const feedback = document.getElementById("form-feedback");

    form?.addEventListener("submit", (e) => {
        e.preventDefault();
        if (feedback) feedback.textContent = "";

        const email = emailInput?.value.trim() ?? "";
        const password = passInput?.value ?? "";

        if (!email || !password) {
            if (feedback) feedback.textContent = "Completa correo y contraseña.";
            return;
        }

        if (!credencialesConfiguradas()) {
            if (feedback) feedback.textContent = "Error: .env no configurado";
            return;
        }

        if (iniciarSesion(email, password)) {
            window.location.href = "/seleccion";
        } else {
            if (feedback)
                feedback.textContent = "Correo o contraseña incorrectos.";
        }
    });
</script>

<style>
    .login-layout {
        display: flex;
        min-height: 100vh;
    }
    .login-left {
        flex: 1;
        display: grid;
        place-items: center;
        background: #f1f5f9;
        border-right: 1px solid #e2e8f0;
    }
    .logo-placeholder {
        text-align: center;
    }
    .logo-placeholder span {
        font-size: 2.5rem;
        font-weight: 800;
        letter-spacing: 0.2em;
    }
    .logo-placeholder p {
        margin: 0.5rem 0 0;
        color: #64748b;
        font-size: 0.9rem;
    }
    .login-right {
        flex: 1;
        display: grid;
        place-items: center;
        padding: 2rem;
    }
    #login-form {
        width: 100%;
        max-width: 320px;
        display: flex;
        flex-direction: column;
        gap: 0.6rem;
    }
    #login-form h2 {
        margin: 0 0 0.5rem;
    }
    #login-form label {
        font-size: 0.9rem;
        font-weight: 600;
    }
    #login-form input {
        padding: 0.6rem 0.7rem;
        border: 1px solid #cbd5e1;
        border-radius: 6px;
    }
    #login-form button {
        margin-top: 0.5rem;
        padding: 0.6rem;
        border: none;
        border-radius: 6px;
        background: #0f172a;
        color: white;
        cursor: pointer;
    }
    #login-form button:hover {
        background: #1e293b;
    }
    #form-feedback {
        min-height: 1.2em;
        font-size: 0.85rem;
        color: #dc2626;
    }

    @media (max-width: 768px) {
        .login-layout {
            flex-direction: column;
        }
        .login-left {
            padding: 3rem 1rem;
            border-right: none;
            border-bottom: 1px solid #e2e8f0;
        }
    }
</style>
