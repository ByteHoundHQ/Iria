---

---

<div class="login-layout" data-vista-login>
    <div class="login-left">
        <h1 class="brand">IRIA</h1>
        <p class="tagline">Connect. Create. Communicate.</p>
    </div>

    <div class="login-right">
        <h2 class="welcome">Welcome!</h2>
        <p class="welcome-sub">Enter Your Details Below</p>

        <div class="card-outer">
            <div class="card-inner">
                <svg
                    class="card-bg"
                    viewBox="0 0 400 600"
                    preserveAspectRatio="none"
                    aria-hidden="true"
                >
                    <path
                        d="M0,238 C0,200 16,188 42,183 C68,178 78,172 88,150 L106,98 C112,82 122,68 144,68 L400,68 L400,600 L0,600 Z"
                        fill="#ffffff"></path>
                </svg>

                <form id="login-form" novalidate>
                    <label for="email">Email</label>
                    <input
                        id="email"
                        name="email"
                        type="email"
                        autocomplete="username"
                    />

                    <label for="password">Password</label>
                    <input
                        id="password"
                        name="password"
                        type="password"
                        autocomplete="current-password"
                    />

                    <div class="btn-group">
                        <button type="submit" id="btn-submit">Log In</button>
                        <button type="button" id="btn-signup">Sign Up</button>
                    </div>

                    <p id="form-feedback" role="alert" aria-live="polite"></p>
                </form>
            </div>
        </div>
    </div>
</div>

<script>
    import {
        cerrarSesion,
        credencialesConfiguradas,
        iniciarSesion,
    } from "../lib/auth.ts";

    cerrarSesion();

    const form = document.getElementById("login-form") as HTMLFormElement | null;
    const emailInput = document.getElementById(
        "email",
    ) as HTMLInputElement | null;
    const passInput = document.getElementById(
        "password",
    ) as HTMLInputElement | null;
    const feedback = document.getElementById("form-feedback");
    const signupBtn = document.getElementById("btn-signup");

    function mostrarAviso(
        variante: "error" | "info",
        mensaje: string,
        resaltar: HTMLElement[] = [],
    ) {
        if (!feedback) return;
        feedback.dataset.variant = variante;
        feedback.textContent = mensaje;
        // Reinicia la animación para que se note cada aviso
        feedback.classList.remove("aviso-pop");
        void feedback.offsetWidth;
        feedback.classList.add("aviso-pop");
        form?.classList.remove("sacudir");
        if (variante === "error") {
            void form?.offsetWidth;
            form?.classList.add("sacudir");
        }
        [emailInput, passInput].forEach((i) =>
            i?.classList.remove("input-error"),
        );
        resaltar.forEach((i) => i.classList.add("input-error"));
    }

    function limpiarAviso() {
        if (!feedback) return;
        feedback.textContent = "";
        feedback.removeAttribute("data-variant");
        feedback.classList.remove("aviso-pop");
    }

    [emailInput, passInput].forEach((i) =>
        i?.addEventListener("input", () => {
            i.classList.remove("input-error");
            const correoActual = emailInput?.value.trim() ?? "";
            // Si el correo ya es válido, quita el aviso de formato
            if (
                feedback?.textContent?.includes("correo válido") &&
                esCorreoValido(correoActual)
            ) {
                limpiarAviso();
                return;
            }
            if (!emailInput?.value && !passInput?.value) limpiarAviso();
        }),
    );

    function esCorreoValido(correo: string): boolean {
        return /^[^\s@]+@[^\s@]+\.[^\s@]{2,}$/.test(correo);
    }

    form?.addEventListener("submit", (e) => {
        e.preventDefault();
        limpiarAviso();

        const email = emailInput?.value.trim() ?? "";
        const password = passInput?.value ?? "";

        if (!email && !password) {
            mostrarAviso(
                "error",
                "Ingresa tu correo y contraseña para continuar.",
                [emailInput, passInput].filter(
                    (x): x is HTMLInputElement => !!x,
                ),
            );
            return;
        }

        if (!email) {
            mostrarAviso("error", "Te falta ingresar tu correo.", [
                emailInput as HTMLInputElement,
            ]);
            return;
        }

        if (!esCorreoValido(email)) {
            mostrarAviso(
                "error",
                "Ingresa un correo válido, por ejemplo nombre@ejemplo.com.",
                [emailInput as HTMLInputElement],
            );
            return;
        }

        if (!password) {
            mostrarAviso("error", "Te falta ingresar tu contraseña.", [
                passInput as HTMLInputElement,
            ]);
            return;
        }

        if (!credencialesConfiguradas()) {
            mostrarAviso(
                "error",
                "No pudimos validar tus datos (configuración faltante).",
            );
            return;
        }

        if (iniciarSesion(email, password)) {
            window.location.href = "/seleccion";
        } else {
            mostrarAviso(
                "error",
                "Correo o contraseña incorrectos. Inténtalo de nuevo.",
                [emailInput, passInput].filter(
                    (x): x is HTMLInputElement => !!x,
                ),
            );
        }
    });

    signupBtn?.addEventListener("click", () => {
        mostrarAviso(
            "info",
            "El registro está deshabilitado. Usa tu cuenta existente.",
        );
    });
</script>

<style>
    .login-layout {
        display: flex;
        min-height: 100vh;
        background: #6e0d0d;
        font-family:
            system-ui,
            -apple-system,
            "Segoe UI",
            Roboto,
            sans-serif;
    }
    .login-left {
        flex: 1.1;
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        padding: 2rem;
    }
    .brand {
        margin: 0;
        color: #fff8c9;
        font-weight: 900;
        font-size: clamp(6rem, 17vw, 13rem);
        line-height: 0.9;
        letter-spacing: -0.02em;
        font-stretch: condensed;
    }
    .tagline {
        margin: 0.8rem 0 0;
        color: #fff;
        font-weight: 700;
        font-size: 1.25rem;
        letter-spacing: -0.01em;
    }
    .login-right {
        flex: 1;
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        padding: 3rem 2rem;
    }
    .welcome {
        margin: 0;
        color: #fff6e3;
        font-size: clamp(2.2rem, 4vw, 3.4rem);
        font-weight: 800;
        letter-spacing: 0.01em;
    }
    .welcome-sub {
        margin: 0.4rem 0 1.6rem;
        color: #fff;
        font-weight: 700;
        font-size: 1.15rem;
    }
    .card-outer {
        width: 100%;
        max-width: 580px;
        padding: 16px;
        border-radius: 32px;
        background: linear-gradient(
            135deg,
            #fff4b9 0%,
            #fff9de 12%,
            #7a1414 30%,
            #5e0d0d 37%,
            #8ca0a6 60%,
            #d2dfe0 78%,
            #4a2b15 100%
        );
        box-shadow: 0 20px 60px rgba(0, 0, 0, 0.35);
    }
    .card-inner {
        position: relative;
        border-radius: 22px;
        overflow: hidden;
        background: linear-gradient(
            100deg,
            #fff2ad 0%,
            #fff6cc 32%,
            #fdf6e3 48%,
            #eef1f1 70%,
            #dfe8e9 100%
        );
        min-height: 480px;
    }
    .card-bg {
        position: absolute;
        inset: 0;
        width: 100%;
        height: 100%;
        display: block;
    }
    #login-form {
        position: relative;
        z-index: 2;
        padding: 185px 2.8rem 1.8rem;
        display: flex;
        flex-direction: column;
    }
    #login-form label {
        font-weight: 800;
        font-size: 1.05rem;
        color: #111;
        margin: 0 0 0.35rem;
    }
    #login-form input {
        border: none;
        border-bottom: 1.5px solid #4b4b4b;
        padding: 0.5rem 0.15rem 0.55rem;
        margin-bottom: 1.7rem;
        font-size: 1rem;
        outline: none;
        background: transparent;
        border-radius: 0;
    }
    #login-form input:focus {
        border-bottom-color: #6e0d0d;
    }
    .btn-group {
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: 0.7rem;
        margin-top: 0.4rem;
    }
    .btn-group button {
        width: 230px;
        padding: 0.65rem;
        border: none;
        border-radius: 999px;
        background: #3f2412;
        color: #fff;
        font-size: 1.05rem;
        font-weight: 500;
        cursor: pointer;
    }
    .btn-group button:hover {
        background: #2f1b0d;
    }
    #login-form input.input-error {
        border-bottom-color: #c1121f;
        background: linear-gradient(
            transparent,
            rgba(193, 18, 31, 0.07)
        );
    }
    #form-feedback:empty {
        display: none;
    }
    #form-feedback {
        display: flex;
        align-items: flex-start;
        gap: 0.6rem;
        margin: 1rem 0 0;
        padding: 0.7rem 0.9rem;
        border-radius: 14px;
        font-size: 0.9rem;
        font-weight: 600;
        line-height: 1.4;
    }
    #form-feedback::before {
        content: "!";
        flex-shrink: 0;
        width: 22px;
        height: 22px;
        border-radius: 999px;
        display: grid;
        place-items: center;
        font-size: 0.85rem;
        font-weight: 800;
        margin-top: 0.05rem;
    }
    #form-feedback[data-variant="error"] {
        background: #fdecec;
        border: 1px solid #f0b4b4;
        color: #7a0d0d;
        box-shadow: 0 6px 18px rgba(122, 13, 13, 0.12);
    }
    #form-feedback[data-variant="error"]::before {
        background: #7a0d0d;
        color: #fff6e3;
    }
    #form-feedback[data-variant="info"] {
        background: #fff6d9;
        border: 1px solid #e7d48b;
        color: #4a2c17;
        box-shadow: 0 6px 18px rgba(74, 44, 23, 0.12);
    }
    #form-feedback[data-variant="info"]::before {
        content: "i";
        background: #4a2c17;
        color: #fff6e3;
        font-style: italic;
    }
    #login-form.sacudir {
        animation: sacudir 0.35s ease;
    }
    .aviso-pop {
        animation: aviso-entrada 0.25s ease;
    }
    @keyframes aviso-entrada {
        from {
            opacity: 0;
            transform: translateY(-4px) scale(0.99);
        }
        to {
            opacity: 1;
            transform: translateY(0) scale(1);
        }
    }
    @keyframes sacudir {
        0%,
        100% {
            transform: translateX(0);
        }
        25% {
            transform: translateX(-5px);
        }
        50% {
            transform: translateX(5px);
        }
        75% {
            transform: translateX(-3px);
        }
    }

    @media (max-width: 900px) {
        .login-layout {
            flex-direction: column;
        }
        .login-left {
            padding: 3rem 1rem 0;
        }
        .brand {
            font-size: clamp(4.5rem, 22vw, 7rem);
        }
        .login-right {
            padding: 2rem 1.2rem 3rem;
        }
    }
</style>
